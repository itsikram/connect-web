# Optional local fallbacks. Prefer Connect Admin → Settings → AI for keys and default models.
# REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here
# REACT_APP_OPENAI_API_KEY=sk-your_openai_key_here

# Other environment variables
# Point the web app at the load balancer (not individual API processes).
REACT_APP_API_BASE_URL=http://localhost:4000
# Optional client fallback if the server has no YOUTUBE_API_KEY
# REACT_APP_YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# REACT_APP_SERVER_ADDR=http://localhost:4000
# REACT_APP_SOCKET_URL=http://localhost:4000
