# Must point at the same server as the Expo app in development, otherwise
# web and mobile users sit on different Socket.IO servers and never see each
# other's real-time events. Switch both to Render together if needed:
# REACT_APP_SERVER_ADDR=https://connect-server-hq4q.onrender.com/
REACT_APP_SERVER_ADDR=http://localhost:4000
BROWSER=none
