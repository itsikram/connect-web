# Public build-time settings for production builds (committed).
# Secrets go in .env.production.local, which is git-ignored.
DISABLE_ESLINT_PLUGIN=true
REACT_APP_BUN_VERSION=latest
REACT_APP_EMOTION_SERVER_URL=https://mug-kid-openings-wanted.trycloudflare.com
REACT_APP_GOOGLE_CLIENT_ID=560231541864-igg3lvikjeii27kd0qoj6drm7jgkh9u6.apps.googleusercontent.com
REACT_APP_LIVE_SERVER_ADDR=https://onlinestorefrontsigns.com
REACT_APP_PORT=3000
# Live API/socket server. A comma-separated list makes each browser stick to
# one server and fail over to the next.
REACT_APP_SERVER_ADDR=https://onlinestorefrontsigns.com
REACT_APP_URL=https://connect-bd.online/
SKIP_PREFLIGHT_CHECK=true
GENERATE_SOURCEMAP=false
TSC_COMPILE_ON_ERROR=true
